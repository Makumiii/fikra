{
  "name": "fikra",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "check": "npm run typecheck && npm run lint && npm run test:backend && npm run build",
    "lint": "oxlint app workers scripts tests",
    "setup:local": "wrangler d1 migrations apply fikra-local --local",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/deploy.mjs",
    "backup:remote": "node scripts/backup-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply fikra-local --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
    "preview": "npm run build && vite preview",
    "email:dev": "email dev --dir app/emails --port 3001",
    "email:export": "email export --dir app/emails --outDir .email-export --pretty --plainText",
    "test": "npm run test:backend && npm run test:e2e",
    "test:backend": "vitest run",
    "test:e2e": "playwright test",
    "e2e:prepare": "npm run setup:local && wrangler d1 execute fikra-local --local --file tests/fixtures/e2e.sql",
    "e2e:serve": "npm run e2e:prepare && OWNER_EMAIL=owner@example.com BETTER_AUTH_SECRET=fikra-e2e-only-secret-change-me npm run dev -- --host 127.0.0.1",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@dicebear/core": "10.6.1",
    "@dicebear/styles": "10.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "better-auth": "^1.7.1",
    "cal-sans": "^1.0.1",
    "emoji-picker-react": "^4.19.1",
    "isbot": "^5.1.36",
    "marked": "^18.0.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "sanitize-html": "^2.17.7",
    "workers-og": "^0.0.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@react-email/ui": "^6.9.3",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "react-email": "^6.9.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.125.0"
  }
}
